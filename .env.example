# ---------- Site ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=hello@flowmanic.ai
# Optional: Calendly / Cal.com link shown on the contact page
NEXT_PUBLIC_BOOKING_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_X_URL=
# Optional: serve /_next/static and /art from a CDN (set at BUILD time), e.g. https://cdn.flowmanic.ai
NEXT_PUBLIC_CDN_URL=
# Optional: privacy-friendly analytics (loaded lazily)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# ---------- Data ----------
# Without DATABASE_URL the site runs on built-in content and the lead form needs a webhook.
# DATABASE_URL=postgres://flowmanic:flowmanic@localhost:5432/flowmanic
PG_POOL_MAX=10
# set to "require" for managed Postgres that needs TLS (Neon, Supabase, RDS)
PGSSL=
# Without REDIS_URL an in-memory cache is used (fine for a single instance)
# REDIS_URL=redis://localhost:6379

# ---------- Leads ----------
# Optional: forward each new lead to n8n / Make / Zapier (JSON) and/or Slack (incoming webhook)
LEAD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
# Salt used to hash visitor IPs for rate limiting (never stored raw)
IP_HASH_SALT=change-me

# ---------- Admin (/admin/leads, HTTP Basic Auth) ----------
ADMIN_USER=admin
ADMIN_PASSWORD=

# ---------- Behind Nginx ----------
# Nginx already gzips responses, so the app can skip it
DISABLE_NEXT_COMPRESSION=false
